graft third_party
include CMakeLists.txt
include README.md README.zh-CN.md LICENSE CONTRIBUTING.md
include Makefile
include python/build_helpers.py
include python/requirements.txt
include NOTICE
include mkdocs.yml
global-exclude __pycache__
global-exclude __pycache__/*
global-exclude *.py[cod]
prune python/triton/_C/weft
prune python/triton/backends/nvidia
prune python/triton/backends/amd
global-exclude *.so *.so.* *.pyd *.dylib *.a *.o
exclude python/triton/FileCheck
prune third_party/nvidia/backend/include
prune third_party/nvidia/backend/bin
prune third_party/nvidia/backend/lib/cupti
prune third_party/nvidia/backend/lib/cupti-blackwell
