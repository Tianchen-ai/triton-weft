function(weft_add_llama_backend cpu_target)
  if (NOT CMAKE_SYSTEM_PROCESSOR MATCHES "riscv|x86_64|AMD64")
    message(FATAL_ERROR "Weft GGML integration requires a supported RISC-V or x86-64 target")
  endif()
  target_sources(${cpu_target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/adapter.cpp")
  target_include_directories(${cpu_target} PUBLIC "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/include")
  target_compile_definitions(${cpu_target} PRIVATE GGML_USE_WEFT)
  target_link_libraries(${cpu_target} PUBLIC Weft::Runtime)
endfunction()
