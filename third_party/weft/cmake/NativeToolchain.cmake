set(WEFT_CLANG_ROOT "" CACHE PATH "Native Clang 23 distribution bundled with the shared SDK")
set(WEFT_OPENMP_LIBRARY "" CACHE FILEPATH "OpenMP library matching the bundled Clang")
set(WEFT_OPENMP_INCLUDE_DIR "" CACHE PATH "Public OpenMP headers")
if(WEFT_CLANG_ROOT)
  if(NOT EXISTS "${WEFT_CLANG_ROOT}/bin/clang" OR NOT EXISTS "${WEFT_CLANG_ROOT}/LICENSE.TXT")
    message(FATAL_ERROR "WEFT_CLANG_ROOT must contain bin/clang and LLVM LICENSE.TXT")
  endif()
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    set(WEFT_NATIVE_CODEGEN "x86-64")
    set(WEFT_NATIVE_RESOURCE_HEADER "immintrin.h")
  elseif(CMAKE_SYSTEM_PROCESSOR STREQUAL "riscv64")
    set(WEFT_NATIVE_CODEGEN "riscv64")
    set(WEFT_NATIVE_RESOURCE_HEADER "riscv_vector.h")
  else()
    message(FATAL_ERROR "No bundled Weft native toolchain contract for ${CMAKE_SYSTEM_PROCESSOR}")
  endif()
  file(GLOB WEFT_NATIVE_HEADERS "${WEFT_CLANG_ROOT}/lib/clang/*/include/${WEFT_NATIVE_RESOURCE_HEADER}")
  if(NOT WEFT_NATIVE_HEADERS)
    message(FATAL_ERROR "Bundled Clang is missing ${WEFT_NATIVE_RESOURCE_HEADER}")
  endif()
  if(NOT CMAKE_CROSSCOMPILING)
    execute_process(COMMAND "${WEFT_CLANG_ROOT}/bin/clang" --version
      OUTPUT_VARIABLE WEFT_CLANG_VERSION COMMAND_ERROR_IS_FATAL ANY)
    if(NOT WEFT_CLANG_VERSION MATCHES "clang version 23\\.")
      message(FATAL_ERROR "The shared SDK requires native Clang 23")
    endif()
    execute_process(COMMAND "${WEFT_CLANG_ROOT}/bin/clang" --print-targets
      OUTPUT_VARIABLE WEFT_CLANG_TARGETS COMMAND_ERROR_IS_FATAL ANY)
    if(NOT WEFT_CLANG_TARGETS MATCHES "${WEFT_NATIVE_CODEGEN}")
      message(FATAL_ERROR "Bundled Clang lacks native ${WEFT_NATIVE_CODEGEN} codegen")
    endif()
  endif()
  get_filename_component(WEFT_CLANG_BINARY "${WEFT_CLANG_ROOT}/bin/clang" REALPATH)
  install(PROGRAMS "${WEFT_CLANG_BINARY}" DESTINATION ${WEFT_INSTALL_ROOT}/bin RENAME clang)
  install(DIRECTORY "${WEFT_CLANG_ROOT}/lib/clang" DESTINATION ${WEFT_INSTALL_ROOT}/lib)
  install(FILES "${WEFT_CLANG_ROOT}/LICENSE.TXT" DESTINATION ${WEFT_INSTALL_ROOT}/licenses/llvm)
endif()
if(WEFT_OPENMP_LIBRARY)
  if(NOT EXISTS "${WEFT_OPENMP_INCLUDE_DIR}/omp.h")
    message(FATAL_ERROR "Bundled OpenMP requires its public omp.h")
  endif()
  execute_process(COMMAND "${CMAKE_NM}" -D --defined-only "${WEFT_OPENMP_LIBRARY}"
    OUTPUT_VARIABLE WEFT_OPENMP_SYMBOLS COMMAND_ERROR_IS_FATAL ANY)
  foreach(WEFT_OPENMP_ENTRY __kmpc_fork_call __kmpc_for_static_init_8 __kmpc_dispatch_deinit)
    if(NOT WEFT_OPENMP_SYMBOLS MATCHES "[ \t][TW][ \t]+${WEFT_OPENMP_ENTRY}(@@[^\r\n ]+)?([\r\n]|$)")
      message(FATAL_ERROR "Bundled OpenMP lacks ${WEFT_OPENMP_ENTRY}; use the Clang 23 runtime")
    endif()
  endforeach()
  install(FILES "${WEFT_OPENMP_LIBRARY}" DESTINATION ${WEFT_INSTALL_ROOT}/lib)
  install(FILES "${WEFT_OPENMP_INCLUDE_DIR}/omp.h" DESTINATION ${WEFT_INSTALL_ROOT}/include)
endif()
